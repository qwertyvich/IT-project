  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session"
      }
    },
    "schemas": {
      "TransferCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from_account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "to_account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "amount": {
            "type": "string",
            "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
          },
          "request_key": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "from_account_id",
          "to_account_id",
          "amount",
          "request_key"
        ]
      },
      "TransferView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transfer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "enum": [
              "pending",
              "completed",
              "cancelled"
            ]
          },
          "request_key": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "transfer_id",
          "status",
          "request_key",
          "request_id"
        ]
      },
      "PostingResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "transfer_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "const": "completed"
          },
          "finished_at": {
            "type": "string",
            "format": "date-time"
          },
          "request_key": {
            "type": "string",
            "format": "uuid"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "transfer_id",
          "status",
          "finished_at",
          "request_key",
          "request_id"
        ]
      },
      "LoanCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contract_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S",
            "description": "Номер утверждённого договора в формате банка; крайние пробелы удаляются до сравнения. Номер сохраняется неизменным."
          },
          "account_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "principal": {
            "type": "string",
            "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
          },
          "annual_rate": {
            "type": "string",
            "pattern": "^[0-9]{1,3}\\.[0-9]{2}$"
          },
          "issued_on": {
            "type": "string",
            "format": "date"
          },
          "due_on": {
            "type": "string",
            "format": "date"
          },
          "payment_dates": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "required": [
          "contract_ref",
          "account_id",
          "principal",
          "annual_rate",
          "issued_on",
          "due_on",
          "payment_dates"
        ]
      },
      "ScheduleItem": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "payment_no": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "due_on": {
            "type": "string",
            "format": "date"
          },
          "principal_part": {
            "type": "string",
            "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
          },
          "interest_part": {
            "type": "string",
            "pattern": "^[0-9]{1,12}\\.[0-9]{2}$"
          }
        },
        "required": [
          "payment_no",
          "due_on",
          "principal_part",
          "interest_part"
        ]
      },
      "LoanView": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "loan_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "contract_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "\\S",
            "description": "Номер утверждённого договора в формате банка; крайние пробелы удаляются до сравнения. Номер сохраняется неизменным."
          },
          "created_by": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "status": {
            "enum": [
              "registered",
              "closed"
            ]
          },
          "schedule": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScheduleItem"
            }
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "loan_id",
          "contract_ref",
          "created_by",
          "status",
          "schedule",
          "request_id"
        ]
      },
      "CloseCommand": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "close_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "close_ref"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "error",
          "request_id"
        ]
      }
    }
  }
}
