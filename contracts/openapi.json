        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanCommand"
              }
            }
          }
        },
        "description": "contract_ref однозначно обозначает исходный утверждённый договор. Новый договор: 201. Совпавший повтор ссылки, счёта и всех условий: 200 с прежними loan_id, автором, текущим состоянием и планом; повторного аудита создания нет. Иные условия с той же ссылкой: 409 BT005. Первая дата платежа строго позже issued_on; даты возрастают, последняя равна due_on. При потере ответа повторяется исходная команда с прежним contract_ref."
      }
    },
