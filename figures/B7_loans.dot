digraph B7_loans {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"e" [label="Кредитный\nспециалист", shape="box", style="filled", fillcolor="#A4C8EA", width="1.792"];
"p1" [label="F4.1 Проверить\nдоговор", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.264"];
"p2" [label="F4.2 Построить и\nсохранить план", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.431"];
"p3" [label="F4.3 Закрыть\nдоговор", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="1.972"];
"D1" [label="D1\nКлиенты\nи счета", shape="record", style="filled", fillcolor="#D9EAD3", width="1.444"];
"D4" [label="D4\nДоговоры\nи графики", shape="record", style="filled", fillcolor="#D9EAD3", width="1.625"];
"D5" [label="D5\nАудит", shape="record", style="filled", fillcolor="#D9EAD3", width="1.139"];
e -> p1 [label="Утверждённые\nусловия"];
D1 -> p1 [label="Счёт; сотрудник"];
p1 -> p2 [label="Сумма; ставка;\nдаты"];
p1 -> e [label="Ошибки условий"];
p2 -> D4 [label="Договор и весь\nграфик"];
p2 -> D5 [label="Аудит регистрации"];
p2 -> e [label="Договор и\nпроверенный план"];
e -> p3 [label="Подтверждение\nзакрытия"];
D4 -> p3 [label="Текущий договор"];
p3 -> D4 [label="closed; close_ref"];
p3 -> D5 [label="Автор и основание"];
p3 -> e [label="Итог закрытия /\nотказ"];
}