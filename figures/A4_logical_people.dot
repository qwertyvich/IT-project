digraph A4_logical_people {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=16, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=15, color="#333333", penwidth=1.2, arrowsize=.75];
branch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Отделение<BR/>branch</B></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">branch_id</TD><TD WIDTH="114" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_code" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">branch_code</TD><TD WIDTH="114" ALIGN="LEFT">varchar(10)</TD><TD WIDTH="80" ALIGN="LEFT">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="city" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">city</TD><TD WIDTH="114" ALIGN="LEFT">varchar(100)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="address" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">address</TD><TD WIDTH="114" ALIGN="LEFT">varchar(200)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR></TABLE>>];
client [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Клиент<BR/>client</B></TD></TR><TR><TD PORT="client_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">client_id</TD><TD WIDTH="114" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="full_name" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">full_name</TD><TD WIDTH="114" ALIGN="LEFT">varchar(150)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="phone" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">phone</TD><TD WIDTH="114" ALIGN="LEFT">varchar(20)</TD><TD WIDTH="80" ALIGN="LEFT">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="email" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">email</TD><TD WIDTH="114" ALIGN="LEFT">varchar(150)</TD><TD WIDTH="80" ALIGN="LEFT">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="registered_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="117" ALIGN="LEFT">registered_at</TD><TD WIDTH="114" ALIGN="LEFT">timestamptz</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR></TABLE>>];
account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Счёт<BR/>account</B></TD></TR><TR><TD PORT="account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">account_id</TD><TD WIDTH="122" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="account_number" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">account_number</TD><TD WIDTH="122" ALIGN="LEFT">varchar(20)</TD><TD WIDTH="80" ALIGN="LEFT">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="client_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">client_id</TD><TD WIDTH="122" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">branch_id</TD><TD WIDTH="122" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="opened_on" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">opened_on</TD><TD WIDTH="122" ALIGN="LEFT">date</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="status" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">status</TD><TD WIDTH="122" ALIGN="LEFT">varchar(10)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="opening_balance" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">opening_balance</TD><TD WIDTH="122" ALIGN="LEFT">numeric(14,2)</TD><TD WIDTH="80" ALIGN="LEFT">NN, ≥0</TD></TR></TABLE></TD></TR><TR><TD PORT="balance" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="148" ALIGN="LEFT">balance</TD><TD WIDTH="122" ALIGN="LEFT">numeric(14,2)</TD><TD WIDTH="80" ALIGN="LEFT">NN, ≥0</TD></TR></TABLE></TD></TR></TABLE>>];
employee [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Сотрудник<BR/>employee</B></TD></TR><TR><TD PORT="employee_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">employee_id</TD><TD WIDTH="114" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">branch_id</TD><TD WIDTH="114" ALIGN="LEFT">integer</TD><TD WIDTH="80" ALIGN="LEFT">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="login" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">login</TD><TD WIDTH="114" ALIGN="LEFT">varchar(80)</TD><TD WIDTH="80" ALIGN="LEFT">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="password_hash" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">password_hash</TD><TD WIDTH="114" ALIGN="LEFT">text</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="full_name" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">full_name</TD><TD WIDTH="114" ALIGN="LEFT">varchar(150)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="role_code" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">role_code</TD><TD WIDTH="114" ALIGN="LEFT">varchar(20)</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="is_active" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD WIDTH="137" ALIGN="LEFT">is_active</TD><TD WIDTH="114" ALIGN="LEFT">boolean</TD><TD WIDTH="80" ALIGN="LEFT">NN</TD></TR></TABLE></TD></TR></TABLE>>];
account:client_id -> client:client_id [label="", arrowhead="normal", arrowsize=".65"];
account:branch_id -> branch:branch_id [label="", arrowhead="normal", arrowsize=".65"];
employee:branch_id -> branch:branch_id [label="", arrowhead="normal", arrowsize=".65"];
}