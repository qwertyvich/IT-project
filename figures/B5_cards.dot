"F2_2" [label="F2.2\nИзменить состояние\nкарты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.292"];
E1 -> F2_2 [label="F03 Команда карты"];
"F2_3" [label="F2.3\nПоказать\nдоступность карты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.042"];
E1 -> F2_3 [label="F03 Команда карты"];
"F1" [label="F1\nВести клиентов,\nсчета и отделения", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.013"];
F2_1 -> F1 [label="I21 Запрос\nконтекста карты"];
F2_2 -> F1 [label="I21 Запрос\nконтекста карты"];
F2_3 -> F1 [label="I21 Запрос\nконтекста карты"];
F1 -> F2_1 [label="I12 Контекст карты"];
F1 -> F2_2 [label="I12 Контекст карты"];
F1 -> F2_3 [label="I12 Контекст карты"];
"F5" [label="F5\nВыдавать сведения и\nотчёты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.417"];
F2_1 -> F5 [label="I25 Результат\nкарты"];
F2_2 -> F5 [label="I25 Результат\nкарты"];
F2_3 -> F5 [label="I25 Результат\nкарты"];
"D2" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D2</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Банковские карты</TD></TR></TABLE>>];
D2 -> F2_1 [label="R22 Состояние\nкарты"];
D2 -> F2_2 [label="R22 Состояние\nкарты"];
D2 -> F2_3 [label="R22 Состояние\nкарты"];
F2_1 -> D2 [label="W22 Сохранённая\nкарта"];
F2_2 -> D2 [label="W22 Сохранённая\nкарта"];
"D5" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D5</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Аудит</TD></TR></TABLE>>];
F2_1 -> D5 [label="W25 Аудит карты"];
F2_2 -> D5 [label="W25 Аудит карты"];
F2_1 -> F2_3 [label="L21 Сохранённая\nкарта"];
F2_2 -> F2_3 [label="L22 Новое\nсостояние"];
}