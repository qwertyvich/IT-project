digraph B5_cards {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"e" [label="Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.583"];
"p1" [label="F2.1 Проверить\nкарту", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.264"];
"p2" [label="F2.2 Изменить\nсостояние", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.125"];
"p3" [label="F2.3 Выдать\nдоступность", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="1.889"];
"D1" [label="D1\nКлиенты\nи счета", shape="record", style="filled", fillcolor="#D9EAD3", width="1.444"];
"D2" [label="D2\nБанковские\nкарты", shape="record", style="filled", fillcolor="#D9EAD3", width="1.792"];
"D5" [label="D5\nАудит", shape="record", style="filled", fillcolor="#D9EAD3", width="1.139"];
e -> p1 [label="Номер; счёт; даты"];
D1 -> p1 [label="Владелец;\nсостояние счёта"];
D2 -> p1 [label="Дубли и прежняя\nкарта"];
p1 -> D2 [label="Карта"];
p1 -> e [label="Карточка / ошибка"];
e -> p2 [label="Команда состояния"];
D2 -> p2 [label="Текущее состояние"];
p2 -> D2 [label="Новое состояние"];
p2 -> D5 [label="Аудит"];
D2 -> p3 [label="Карта и даты"];
D1 -> p3 [label="Состояние счёта"];
p3 -> e [label="Признак\nдоступности"];
}