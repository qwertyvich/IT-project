digraph G1_architecture {
graph [rankdir=TB, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=21, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=20, color="#333333", penwidth=1.2, arrowsize=.75];
graph [nodesep=.3, ranksep=.2];
"e1" [label="Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.792"];
"e2" [label="Кредитный\nспециалист", shape="box", style="filled", fillcolor="#A4C8EA", width="2.042"];
"e3" [label="Контролёр /\nруководитель", shape="box", style="filled", fillcolor="#A4C8EA", width="2.333"];
"e4" [label="Администратор", shape="box", style="filled", fillcolor="#A4C8EA", width="2.597"];
"К1" [label="Клиентский контекст\nК1", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.292"];
"К2" [label="Карточное\nобслуживание\nК2", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.431"];
"К3" [label="Проведение\nпереводов\nК3", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.139"];
"К4" [label="Кредитный учёт и\nпланирование\nК4", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.903"];
"К5" [label="Представление и\nконтроль\nрезультатов\nК5", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.847"];
"К6" [label="Доверие к действиям\nК6", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.375"];
"Д1" [label="Д1\nКлиентский контекст", shape="cylinder", style="filled", fillcolor="#D9EAD3", width="3.292"];
"Д2" [label="Д2\nКарты", shape="cylinder", style="filled", fillcolor="#D9EAD3", width="1.292"];
"Д3" [label="Д3\nПереводы", shape="cylinder", style="filled", fillcolor="#D9EAD3", width="1.847"];
"Д4" [label="Д4\nДоговоры и графики", shape="cylinder", style="filled", fillcolor="#D9EAD3", width="3.250"];
"Д5" [label="Д5\nАудит", shape="cylinder", style="filled", fillcolor="#D9EAD3", width="1.264"];
e1 -> К6 [label="И1: команда\n/ результат", dir="both"];
e2 -> К6 [label="И1: команда\n/ результат", dir="both"];
e3 -> К6 [label="И1: команда\n/ результат", dir="both"];
e4 -> К6 [label="И1: команда\n/ результат", dir="both"];
К6 -> К1 [label="И2: действие\n/ ответ", dir="both"];
К6 -> К2 [label="И2: действие\n/ ответ", dir="both"];
К6 -> К3 [label="И2: действие\n/ ответ", dir="both"];
К6 -> К4 [label="И2: действие\n/ ответ", dir="both"];
К6 -> К5 [label="И2: действие\n/ ответ", dir="both"];
К1 -> Д1 [label="И3: данные /\nрезультат", dir="both"];
К2 -> Д2 [label="И3: данные /\nрезультат", dir="both"];
К3 -> Д1 [label="И3: данные /\nрезультат", dir="both"];
К3 -> Д3 [label="И3: данные /\nрезультат", dir="both"];
К4 -> Д4 [label="И3: данные /\nрезультат", dir="both"];
Д1 -> К5 [label="И3: факты\nдля чтения"];
Д2 -> К5 [label="И3: факты\nдля чтения"];
Д3 -> К5 [label="И3: факты\nдля чтения"];
Д4 -> К5 [label="И3: факты\nдля чтения"];
Д5 -> К5 [label="И3: факты\nдля чтения"];
К1 -> К2 [label="И5: контекст\n/ запрос", dir="both"];
К1 -> К3 [label="И5: контекст\n/ запрос", dir="both"];
К1 -> К4 [label="И5: контекст\n/ запрос", dir="both"];
К1 -> К5 [label="И6:\nрезультат\nдействия"];
К2 -> К5 [label="И6:\nрезультат\nдействия"];
К3 -> К5 [label="И6:\nрезультат\nдействия"];
К4 -> К5 [label="И6:\nрезультат\nдействия"];
К1 -> Д5 [label="И4: событие\nдействия"];
К2 -> Д5 [label="И4: событие\nдействия"];
К3 -> Д5 [label="И4: событие\nдействия"];
К4 -> Д5 [label="И4: событие\nдействия"];
К6 -> Д5 [label="И4: единые\nправила\nаудита"];
