digraph E1_quality {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=23, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=22, color="#333333", penwidth=1.2, arrowsize=.75];
"need" [label="Потребность\nпользователя\nи требования РН", shape="box", style="rounded,filled", fillcolor="#A4C8EA", width="2.986"];
"crit" [label="Критерии качества\nнорма и способ\nизмерения", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.278"];
"case" [label="Проверка: данные,\nдействия, эталон", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.278"];
"run" [label="Запуск: версия,\nсреда, исполнитель", shape="box", style="rounded,filled", fillcolor="#A4C8EA", width="3.416"];
"obs" [label="Наблюдение: факт,\nвремя, повторный\nввод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.347"];
"proof" [label="Свидетельства:\nснимки,\nжурналы, SHA-256", shape="box", style="rounded,filled", fillcolor="#D9EAD3", width="3.250"];
"decision" [label="Сравнение с нормой\nи решение по\nтребованию", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.569"];
"accept" [label="Все обязательные\nнормы\nи сквозные задачи\nвыполнены", shape="box", style="rounded,filled", fillcolor="#D9EAD3", width="3.236"];
need -> crit [label="Вывод нормы"];
crit -> case [label="Метод"];
case -> run [label="Выполнение"];
run -> obs [label="Измерение"];
obs -> proof [label="Фиксация"];
proof -> decision [label="Объективные данные"];
crit -> decision [label="Порог"];
decision -> accept [label="Совместная приёмка"];
}