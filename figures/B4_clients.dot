digraph B4_clients {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"e" [label="Оператор /\nадминистратор", shape="box", style="filled", fillcolor="#A4C8EA", width="2.222"];
"p1" [label="F1.1 Проверить\nреквизиты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.264"];
"p2" [label="F1.2 Сохранить\nклиента / счёт", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.250"];
"p3" [label="F1.3 Настроить\nдоступ", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.222"];
"D1" [label="D1\nКлиенты\nи счета", shape="record", style="filled", fillcolor="#D9EAD3", width="1.444"];
"D5" [label="D5\nАудит", shape="record", style="filled", fillcolor="#D9EAD3", width="1.139"];
e -> p1 [label="Карточка; счёт;\nнастройки"];
D1 -> p1 [label="Контакты; номера;\nроль"];
p1 -> p2 [label="Допустимые данные"];
p1 -> e [label="Ошибки"];
p2 -> D1 [label="Клиент; счёт"];
p2 -> D5 [label="Автор; до/после"];
p2 -> e [label="Карточка"];
e -> p3 [label="Справочники;\nсотрудники"];
p3 -> D1 [label="Роли и отделения"];
p3 -> D5 [label="Аудит"];
}