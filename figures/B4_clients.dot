digraph B4_clients {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=21, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=20, color="#333333", penwidth=1.2, arrowsize=.75];
"E1" [label="E1\nОператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.792"];
"F1_1" [label="F1.1\nВести реквизиты\nклиента", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.778"];
E1 -> F1_1 [label="F01 Клиент и счёт"];
"F1_2" [label="F1.2\nВести счета и\nконтекст", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.375"];
E1 -> F1_2 [label="F01 Клиент и счёт"];
"E4" [label="E4\nАдминистратор", shape="box", style="filled", fillcolor="#A4C8EA", width="2.597"];
"F1_3" [label="F1.3\nВести отделения и\nсотрудников", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.055"];
E4 -> F1_3 [label="F11 Справочные\nданные"];
"F2" [label="F2\nВести банковские\nкарты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.903"];
F2 -> F1_2 [label="I21 Запрос\nконтекста карты"];
F1_2 -> F2 [label="I12 Контекст карты"];
"F3" [label="F3\nУчитывать и\nпроводить переводы", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.306"];
F3 -> F1_2 [label="I31 Запрос счетов"];
F1_2 -> F3 [label="I13 Реквизиты\nсчетов"];
"F4" [label="F4\nВести кредитные\nдоговоры", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.819"];
F4 -> F1_2 [label="I41 Запрос счёта\nдоговора"];
F1_2 -> F4 [label="I14 Контекст\nдоговора"];
"F5" [label="F5\nВыдавать сведения и\nотчёты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.417"];
F1_1 -> F5 [label="I15 Клиентский\nрезультат"];
F1_2 -> F5 [label="I15 Клиентский\nрезультат"];
F1_3 -> F5 [label="I15 Клиентский\nрезультат"];
"D1" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D1</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Клиенты, счета,<BR/>отделения,<BR/>сотрудники</TD></TR></TABLE>>];
D1 -> F1_1 [label="R01 Текущий\nконтекст"];
D1 -> F1_2 [label="R01 Текущий\nконтекст"];
D1 -> F1_3 [label="R01 Текущий\nконтекст"];
F1_1 -> D1 [label="W01 Сохранённый\nконтекст"];
F1_2 -> D1 [label="W01 Сохранённый\nконтекст"];
F1_3 -> D1 [label="W01 Сохранённый\nконтекст"];
"D5" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D5</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Аудит</TD></TR></TABLE>>];
F1_1 -> D5 [label="W15 Аудит\nконтекста"];
F1_2 -> D5 [label="W15 Аудит\nконтекста"];
F1_3 -> D5 [label="W15 Аудит\nконтекста"];
F1_1 -> F1_2 [label="L11 Идентификатор\nвыбранного клиента"];
}