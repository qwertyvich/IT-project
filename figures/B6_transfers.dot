digraph B6_transfers {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=21, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=20, color="#333333", penwidth=1.2, arrowsize=.75];
"E1" [label="E1\nОператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.792"];
"F3_1" [label="F3.1\nПодготовить /\nотменить перевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.958"];
E1 -> F3_1 [label="F05 Команда\nперевода"];
"F3_2" [label="F3.2\nПроверить и\nпровести перевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.931"];
E1 -> F3_2 [label="F05 Команда\nперевода"];
"F3_3" [label="F3.3\nПоказать итог и\nраспознать повтор", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.042"];
E1 -> F3_3 [label="F05 Команда\nперевода"];
"F1" [label="F1\nВести клиентов,\nсчета и отделения", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.013"];
F3_1 -> F1 [label="I31 Запрос счетов"];
F1 -> F3_1 [label="I13 Реквизиты\nсчетов"];
"F5" [label="F5\nВыдавать сведения и\nотчёты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="3.417"];
F3_3 -> F5 [label="I35 Результат\nперевода"];
"D1" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D1</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Клиенты, счета,<BR/>отделения,<BR/>сотрудники</TD></TR></TABLE>>];
D1 -> F3_2 [label="R03 Счета под\nблокировкой"];
F3_2 -> D1 [label="W03 Парное\nизменение остатков"];
"D3" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D3</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Переводы</TD></TR></TABLE>>];
D3 -> F3_1 [label="R33 Состояние\nперевода"];
D3 -> F3_2 [label="R33 Состояние\nперевода"];
D3 -> F3_3 [label="R33 Состояние\nперевода"];
F3_1 -> D3 [label="W33\nЗафиксированный\nперевод"];
F3_2 -> D3 [label="W33\nЗафиксированный\nперевод"];
"D5" [shape=plain,style="",label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7"><TR><TD BORDER="1" SIDES="TLBR" BGCOLOR="#D9EAD3">D5</TD><TD BORDER="1" SIDES="TB" BGCOLOR="#D9EAD3">Аудит</TD></TR></TABLE>>];
F3_1 -> D5 [label="W35 Аудит перевода"];
F3_2 -> D5 [label="W35 Аудит перевода"];
F3_1 -> F3_3 [label="L31 Подготовка /\nотмена / конфликт"];
F3_2 -> F3_3 [label="L32\nЗафиксированный\nисход / отказ"];
}