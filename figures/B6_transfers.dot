digraph B6_transfers {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"e" [label="Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.583"];
"p1" [label="F3.1 Подготовить\nперевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.486"];
"p2" [label="F3.2 Провести\nперевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.125"];
"p3" [label="F3.3 Сформировать\nитог", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.778"];
"D1" [label="D1\nКлиенты\nи счета", shape="record", style="filled", fillcolor="#D9EAD3", width="1.444"];
"D3" [label="D3\nПереводы", shape="record", style="filled", fillcolor="#D9EAD3", width="1.653"];
"D5" [label="D5\nАудит", shape="record", style="filled", fillcolor="#D9EAD3", width="1.139"];
e -> p1 [label="Счета; сумма; ключ"];
D1 -> p1 [label="Счета и сотрудник"];
p1 -> D3 [label="pending /\ncancelled"];
e -> p2 [label="Команда проведения"];
D3 -> p2 [label="Перевод; повтор;\nстатус"];
D1 -> p2 [label="Остатки; состояния"];
p2 -> D1 [label="Два новых остатка"];
p2 -> D3 [label="completed;\nfinished_at"];
p2 -> D5 [label="Аудит в той же\nоперации"];
p1 -> p3 [label="Создание /\nконфликт"];
p2 -> p3 [label="Зафиксированный\nитог / отказ"];
p3 -> e [label="ID; статус;\nостатки; ошибка"];
}