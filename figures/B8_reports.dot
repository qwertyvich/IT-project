digraph B8_reports {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"e" [label="Сотрудник по роли", shape="box", style="filled", fillcolor="#A4C8EA", width="2.667"];
"p1" [label="F5.1 Проверить\nзапрос", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.264"];
"p2" [label="F5.2 Вычислить\nотчёт", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.278"];
"p3" [label="F5.3 Представить и\nсверить", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.722"];
"D1" [label="D1\nКлиенты\nи счета", shape="record", style="filled", fillcolor="#D9EAD3", width="1.444"];
"D2" [label="D2\nБанковские\nкарты", shape="record", style="filled", fillcolor="#D9EAD3", width="1.792"];
"D3" [label="D3\nПереводы", shape="record", style="filled", fillcolor="#D9EAD3", width="1.653"];
"D4" [label="D4\nДоговоры\nи графики", shape="record", style="filled", fillcolor="#D9EAD3", width="1.625"];
"D5" [label="D5\nАудит", shape="record", style="filled", fillcolor="#D9EAD3", width="1.139"];
e -> p1 [label="Вид; клиент;\nпериод"];
D1 -> p1 [label="Клиент; счета;\nправа"];
p1 -> p2 [label="Допустимый запрос"];
D1 -> p2 [label="Реквизиты; остатки"];
D2 -> p2 [label="Карты и сроки"];
D3 -> p2 [label="Переводы и статусы"];
D4 -> p2 [label="Условия и план"];
D5 -> p2 [label="События"];
p2 -> p3 [label="Строки и агрегаты"];
p1 -> p3 [label="Ошибка запроса"];
p3 -> e [label="Сводка; сверка;\nпериод; время"];
}