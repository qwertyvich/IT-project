digraph A7_reversal {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"E2" [label="E2 Контролёр", shape="box", style="filled", fillcolor="#A4C8EA", width="2.056"];
"F41" [label="F4.1\nПроверить\nконтролёра,\nоригинал и ключ", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.389"];
"F42" [label="F4.2\nПровести полный\nобратный перевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.625"];
"F43" [label="F4.3\nСформировать\nрезультат", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.208"];
"D1" [label="D1\nКлиенты, счета,\nсотрудники,\nполучатели", shape="record", style="filled", fillcolor="#D9EAD3", width="2.292"];
"D3" [label="D3\nФакты переводов\nи основания\nвозврата", shape="record", style="filled", fillcolor="#D9EAD3", width="2.514"];
"D4" [label="D4\nСобытия\nаудита", shape="record", style="filled", fillcolor="#D9EAD3", width="1.472"];
E2 -> F41 [label="original_id;\nпричина; ключ"];
D1 -> F41 [label="Роль сотрудника"];
D3 -> F41 [label="Оригинал;\nсуществующий\nвозврат"];
F41 -> F42 [label="Допустимое\nоснование"];
D1 -> F42 [label="Остатки; состояния"];
F42 -> D1 [label="Остатки после\nвозврата"];
F42 -> D3 [label="reversal и\ntransfer_reversal"];
F42 -> D4 [label="Аудит изменения\nсчетов"];
F41 -> F43 [label="Повтор / отказ"];
F42 -> F43 [label="Итог фиксации"];
F43 -> E2 [label="reversal_transfer_id\n/ ошибка"];
}