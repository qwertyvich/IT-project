digraph A8_reports {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"E1" [label="E1 Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.958"];
"E2" [label="E2 Контролёр", shape="box", style="filled", fillcolor="#A4C8EA", width="2.056"];
"E3" [label="E3 Администратор", shape="box", style="filled", fillcolor="#A4C8EA", width="2.625"];
"F51" [label="F5.1\nПроверить доступ,\nсчёт и период", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.625"];
"F52" [label="F5.2\nВычислить выписку\nили агрегаты", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.736"];
"F53" [label="F5.3\nПредставить\nрезультат\nи время\nактуальности", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.000"];
"D1" [label="D1\nКлиенты, счета,\nсотрудники,\nполучатели", shape="record", style="filled", fillcolor="#D9EAD3", width="2.292"];
"D2" [label="D2\nПоручения\nи реестры", shape="record", style="filled", fillcolor="#D9EAD3", width="1.708"];
"D3" [label="D3\nФакты переводов\nи основания\nвозврата", shape="record", style="filled", fillcolor="#D9EAD3", width="2.514"];
"D4" [label="D4\nСобытия\nаудита", shape="record", style="filled", fillcolor="#D9EAD3", width="1.472"];
E1 -> F51 [label="Счёт; период"];
E2 -> F51 [label="Вид отчёта; период"];
E3 -> F51 [label="Фильтры журнала"];
D1 -> F51 [label="Счёт; владелец;\nроль"];
F51 -> F52 [label="Допустимый запрос"];
D1 -> F52 [label="Клиенты;\nотделения; остатки"];
D2 -> F52 [label="Поручения и\nстатусы"];
D3 -> F52 [label="Денежные факты"];
D4 -> F52 [label="События аудита"];
F52 -> F53 [label="Строки; итоги;\nактуальность"];
F51 -> F53 [label="Ошибка доступа /\nпериода"];
F53 -> E1 [label="Выписка / ошибка"];
F53 -> E2 [label="Контрольный отчёт\n/ ошибка"];
F53 -> E3 [label="Журнал / ошибка"];
}