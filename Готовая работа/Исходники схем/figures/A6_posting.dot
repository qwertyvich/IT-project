digraph A6_posting {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"E1" [label="E1 Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.958"];
"F31" [label="F3.1\nПроверить\nполномочия\nи состояние\nпоручения", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="1.861"];
"F32" [label="F3.2\nПроверить средства\nи провести перевод", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.833"];
"F33" [label="F3.3\nСформировать\nрезультат", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.208"];
"D1" [label="D1\nКлиенты, счета,\nсотрудники,\nполучатели", shape="record", style="filled", fillcolor="#D9EAD3", width="2.292"];
"D2" [label="D2\nПоручения\nи реестры", shape="record", style="filled", fillcolor="#D9EAD3", width="1.708"];
"D3" [label="D3\nФакты переводов\nи основания\nвозврата", shape="record", style="filled", fillcolor="#D9EAD3", width="2.514"];
"D4" [label="D4\nСобытия\nаудита", shape="record", style="filled", fillcolor="#D9EAD3", width="1.472"];
E1 -> F31 [label="order_id; сеанс"];
D2 -> F31 [label="Поручение и статус"];
D1 -> F31 [label="Полномочия\nсотрудника"];
F31 -> F32 [label="Допустимое pending"];
D1 -> F32 [label="Два остатка;\nсостояния"];
F32 -> D1 [label="Два новых остатка"];
F32 -> D2 [label="completed;\nfinished_at"];
F32 -> D3 [label="regular; order_id"];
F32 -> D4 [label="Аудит остатков и\nстатуса"];
F31 -> F33 [label="Повтор / ошибка\nсостояния"];
F32 -> F33 [label="Зафиксированный\nфакт / отказ"];
F33 -> E1 [label="transfer_id либо\nкод ошибки"];
}