digraph A5_orders {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=18, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=17, color="#333333", penwidth=1.2, arrowsize=.75];
"E1" [label="E1 Оператор", shape="box", style="filled", fillcolor="#A4C8EA", width="1.958"];
"F21" [label="F2.1\nПроверить ключ,\nформат и все строки", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.861"];
"F22" [label="F2.2\nСохранить поручения\nили отменить\npending", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.972"];
"F23" [label="F2.3\nЗафиксировать аудит", shape="box", style="rounded,filled", fillcolor="#FFF2B2", width="2.986"];
"D1" [label="D1\nКлиенты, счета,\nсотрудники,\nполучатели", shape="record", style="filled", fillcolor="#D9EAD3", width="2.292"];
"D2" [label="D2\nПоручения\nи реестры", shape="record", style="filled", fillcolor="#D9EAD3", width="1.708"];
"D4" [label="D4\nСобытия\nаудита", shape="record", style="filled", fillcolor="#D9EAD3", width="1.472"];
E1 -> F21 [label="Реквизиты; отмена;\nCSV"];
D1 -> F21 [label="Счета; сотрудник"];
D2 -> F21 [label="Ключ; хеш; статус"];
F21 -> E1 [label="Ошибки строк /\nконфликт"];
F21 -> F22 [label="Проверенный набор"];
F22 -> D2 [label="Реестр и\nпоручения; статус"];
F22 -> F23 [label="Изменения\nпоручений"];
F23 -> D4 [label="События аудита"];
F22 -> E1 [label="order_id /\nbatch_id; статус"];
F21 -> E1 [label="Прежний результат\nповтора"];
}