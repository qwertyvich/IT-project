digraph B4_logical_people {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=16, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=15, color="#333333", penwidth=1.2, arrowsize=.75];
branch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Отделение<BR/>branch</B></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">branch_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_code" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">branch_code</TD><TD ALIGN="LEFT" WIDTH="114">varchar(10)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="city" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">city</TD><TD ALIGN="LEFT" WIDTH="114">varchar(100)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="address" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">address</TD><TD ALIGN="LEFT" WIDTH="114">varchar(200)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR></TABLE>>];
client [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Клиент<BR/>client</B></TD></TR><TR><TD PORT="client_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">client_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="full_name" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">full_name</TD><TD ALIGN="LEFT" WIDTH="114">varchar(150)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="phone" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">phone</TD><TD ALIGN="LEFT" WIDTH="114">varchar(20)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="email" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">email</TD><TD ALIGN="LEFT" WIDTH="114">varchar(150)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="registered_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="117">registered_at</TD><TD ALIGN="LEFT" WIDTH="114">timestamptz</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR></TABLE>>];
account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Счёт<BR/>account</B></TD></TR><TR><TD PORT="account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">account_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="80">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="account_number" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">account_number</TD><TD ALIGN="LEFT" WIDTH="122">varchar(20)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="client_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">client_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="80">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">branch_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="80">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="opening_balance" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">opening_balance</TD><TD ALIGN="LEFT" WIDTH="122">numeric(18,2)</TD><TD ALIGN="LEFT" WIDTH="80">NN, ≥ 0</TD></TR></TABLE></TD></TR><TR><TD PORT="balance" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">balance</TD><TD ALIGN="LEFT" WIDTH="122">numeric(18,2)</TD><TD ALIGN="LEFT" WIDTH="80">NN, ≥ 0</TD></TR></TABLE></TD></TR><TR><TD PORT="status" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">status</TD><TD ALIGN="LEFT" WIDTH="122">varchar(10)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="opened_on" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="148">opened_on</TD><TD ALIGN="LEFT" WIDTH="122">date</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR></TABLE>>];
employee [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Сотрудник<BR/>employee</B></TD></TR><TR><TD PORT="employee_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">employee_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="branch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">branch_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="login" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">login</TD><TD ALIGN="LEFT" WIDTH="114">varchar(80)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="full_name" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">full_name</TD><TD ALIGN="LEFT" WIDTH="114">varchar(150)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="role_code" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">role_code</TD><TD ALIGN="LEFT" WIDTH="114">varchar(20)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="is_active" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">is_active</TD><TD ALIGN="LEFT" WIDTH="114">boolean</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR></TABLE>>];
beneficiary [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Сохранённый получатель<BR/>beneficiary</B></TD></TR><TR><TD PORT="client_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="102">client_id</TD><TD ALIGN="LEFT" WIDTH="105">bigint</TD><TD ALIGN="LEFT" WIDTH="75">PK, FK</TD></TR></TABLE></TD></TR><TR><TD PORT="account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="102">account_id</TD><TD ALIGN="LEFT" WIDTH="105">bigint</TD><TD ALIGN="LEFT" WIDTH="75">PK, FK</TD></TR></TABLE></TD></TR><TR><TD PORT="alias" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="102">alias</TD><TD ALIGN="LEFT" WIDTH="105">varchar(80)</TD><TD ALIGN="LEFT" WIDTH="75">NN</TD></TR></TABLE></TD></TR></TABLE>>];
account:client_id -> client:client_id [label="", arrowhead="normal", arrowsize=".65"];
account:branch_id -> branch:branch_id [label="", arrowhead="normal", arrowsize=".65"];
employee:branch_id -> branch:branch_id [label="", arrowhead="normal", arrowsize=".65"];
beneficiary:client_id -> client:client_id [label="", arrowhead="normal", arrowsize=".65"];
beneficiary:account_id -> account:account_id [label="", arrowhead="normal", arrowsize=".65"];
}