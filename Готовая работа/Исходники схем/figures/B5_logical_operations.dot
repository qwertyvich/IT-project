digraph B5_logical_operations {
graph [rankdir=LR, bgcolor="white", pad=.12, nodesep=.35, ranksep=.65, splines=polyline, outputorder=edgesfirst];
node [fontname="Arial", fontsize=16, margin=".12,.08", penwidth=1.3];
edge [fontname="Arial", fontsize=15, color="#333333", penwidth=1.2, arrowsize=.75];
account [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Счёт<BR/>account<BR/>контекст Б.4</B></TD></TR><TR><TD PORT="account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="102">account_id</TD><TD ALIGN="LEFT" WIDTH="63">bigint</TD><TD ALIGN="LEFT" WIDTH="46">PK</TD></TR></TABLE></TD></TR></TABLE>>];
employee [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Сотрудник<BR/>employee<BR/>контекст Б.4</B></TD></TR><TR><TD PORT="employee_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="116">employee_id</TD><TD ALIGN="LEFT" WIDTH="63">bigint</TD><TD ALIGN="LEFT" WIDTH="46">PK</TD></TR></TABLE></TD></TR></TABLE>>];
payment_batch [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Реестр поручений<BR/>payment_batch</B></TD></TR><TR><TD PORT="batch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="107">batch_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="file_name" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="107">file_name</TD><TD ALIGN="LEFT" WIDTH="114">varchar(255)</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="file_sha256" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="107">file_sha256</TD><TD ALIGN="LEFT" WIDTH="114">char(64)</TD><TD ALIGN="LEFT" WIDTH="80">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="created_by" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="107">created_by</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="80">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="created_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="107">created_at</TD><TD ALIGN="LEFT" WIDTH="114">timestamptz</TD><TD ALIGN="LEFT" WIDTH="80">NN</TD></TR></TABLE></TD></TR></TABLE>>];
payment_order [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Поручение<BR/>payment_order</B></TD></TR><TR><TD PORT="order_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">order_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="95">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="request_key" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">request_key</TD><TD ALIGN="LEFT" WIDTH="122">uuid</TD><TD ALIGN="LEFT" WIDTH="95">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="batch_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">batch_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="95">FK, NULL</TD></TR></TABLE></TD></TR><TR><TD PORT="from_account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">from_account_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="95">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="to_account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">to_account_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="95">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="amount" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">amount</TD><TD ALIGN="LEFT" WIDTH="122">numeric(18,2)</TD><TD ALIGN="LEFT" WIDTH="95">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="status" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">status</TD><TD ALIGN="LEFT" WIDTH="122">varchar(10)</TD><TD ALIGN="LEFT" WIDTH="95">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="created_by" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">created_by</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="95">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="created_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">created_at</TD><TD ALIGN="LEFT" WIDTH="122">timestamptz</TD><TD ALIGN="LEFT" WIDTH="95">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="finished_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">finished_at</TD><TD ALIGN="LEFT" WIDTH="122">timestamptz</TD><TD ALIGN="LEFT" WIDTH="95">NULL *</TD></TR></TABLE></TD></TR></TABLE>>];
transfer [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Проведённый перевод<BR/>transfer</B></TD></TR><TR><TD PORT="transfer_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">transfer_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="127">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="order_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">order_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="127">FK, UQ, NULL</TD></TR></TABLE></TD></TR><TR><TD PORT="request_key" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">request_key</TD><TD ALIGN="LEFT" WIDTH="122">uuid</TD><TD ALIGN="LEFT" WIDTH="127">UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="from_account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">from_account_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="127">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="to_account_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">to_account_id</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="127">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="amount" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">amount</TD><TD ALIGN="LEFT" WIDTH="122">numeric(18,2)</TD><TD ALIGN="LEFT" WIDTH="127">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="kind" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">kind</TD><TD ALIGN="LEFT" WIDTH="122">varchar(10)</TD><TD ALIGN="LEFT" WIDTH="127">NN *</TD></TR></TABLE></TD></TR><TR><TD PORT="posted_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">posted_at</TD><TD ALIGN="LEFT" WIDTH="122">timestamptz</TD><TD ALIGN="LEFT" WIDTH="127">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="posted_by" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="142">posted_by</TD><TD ALIGN="LEFT" WIDTH="122">bigint</TD><TD ALIGN="LEFT" WIDTH="127">FK, NN</TD></TR></TABLE></TD></TR></TABLE>>];
transfer_reversal [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Основание возврата<BR/>transfer_reversal</B></TD></TR><TR><TD PORT="original_transfer_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="165">original_transfer_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="109">PK, FK</TD></TR></TABLE></TD></TR><TR><TD PORT="reversal_transfer_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="165">reversal_transfer_id</TD><TD ALIGN="LEFT" WIDTH="114">bigint</TD><TD ALIGN="LEFT" WIDTH="109">FK, UQ, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="reason" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="165">reason</TD><TD ALIGN="LEFT" WIDTH="114">varchar(500)</TD><TD ALIGN="LEFT" WIDTH="109">NN</TD></TR></TABLE></TD></TR></TABLE>>];
audit_event [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#A4C8EA"><B>Событие аудита<BR/>audit_event</B></TD></TR><TR><TD PORT="event_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">event_id</TD><TD ALIGN="LEFT" WIDTH="109">bigint</TD><TD ALIGN="LEFT" WIDTH="77">PK</TD></TR></TABLE></TD></TR><TR><TD PORT="entity_type" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">entity_type</TD><TD ALIGN="LEFT" WIDTH="109">varchar(40)</TD><TD ALIGN="LEFT" WIDTH="77">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="entity_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">entity_id</TD><TD ALIGN="LEFT" WIDTH="109">bigint</TD><TD ALIGN="LEFT" WIDTH="77">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="action" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">action</TD><TD ALIGN="LEFT" WIDTH="109">varchar(10)</TD><TD ALIGN="LEFT" WIDTH="77">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="actor_id" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">actor_id</TD><TD ALIGN="LEFT" WIDTH="109">bigint</TD><TD ALIGN="LEFT" WIDTH="77">FK, NN</TD></TR></TABLE></TD></TR><TR><TD PORT="occurred_at" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">occurred_at</TD><TD ALIGN="LEFT" WIDTH="109">timestamptz</TD><TD ALIGN="LEFT" WIDTH="77">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="request_key" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">request_key</TD><TD ALIGN="LEFT" WIDTH="109">uuid</TD><TD ALIGN="LEFT" WIDTH="77">NN</TD></TR></TABLE></TD></TR><TR><TD PORT="old_data" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">old_data</TD><TD ALIGN="LEFT" WIDTH="109">jsonb</TD><TD ALIGN="LEFT" WIDTH="77">NULL *</TD></TR></TABLE></TD></TR><TR><TD PORT="new_data" CELLPADDING="0"><TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6"><TR><TD ALIGN="LEFT" WIDTH="111">new_data</TD><TD ALIGN="LEFT" WIDTH="109">jsonb</TD><TD ALIGN="LEFT" WIDTH="77">NULL *</TD></TR></TABLE></TD></TR></TABLE>>];
payment_batch:created_by -> employee:employee_id [label="", arrowhead="normal", arrowsize=".65"];
payment_order:batch_id -> payment_batch:batch_id [label="", arrowhead="normal", arrowsize=".65"];
payment_order:from_account_id -> account:account_id [label="", arrowhead="normal", arrowsize=".65"];
payment_order:to_account_id -> account:account_id [label="", arrowhead="normal", arrowsize=".65"];
payment_order:created_by -> employee:employee_id [label="", arrowhead="normal", arrowsize=".65"];
transfer:order_id -> payment_order:order_id [label="", arrowhead="normal", arrowsize=".65"];
transfer:from_account_id -> account:account_id [label="", arrowhead="normal", arrowsize=".65"];
transfer:to_account_id -> account:account_id [label="", arrowhead="normal", arrowsize=".65"];
transfer:posted_by -> employee:employee_id [label="", arrowhead="normal", arrowsize=".65"];
transfer_reversal:original_transfer_id -> transfer:transfer_id [label="", arrowhead="normal", arrowsize=".65"];
transfer_reversal:reversal_transfer_id -> transfer:transfer_id [label="", arrowhead="normal", arrowsize=".65"];
audit_event:actor_id -> employee:employee_id [label="", arrowhead="normal", arrowsize=".65"];
}